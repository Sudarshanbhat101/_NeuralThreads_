{
  "manifest_version": 3,
  "name": "DomScrap",
  "version": "0.1",
  "description": "Reads a Claude chat and saves it as markdown.",
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": ["https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["selectors.js", "content.js"]
    }
  ]
}